# Salin menjadi .env lalu isi
# Neon: https://neon.tech -> Connection string (pakai yang "pooled" atau biasa)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
PORT=4000
CORS_ORIGIN=http://localhost:5173
# true = endpoint simulasi pembayaran aktif. Set false di production.
DEMO_MODE=true
# Layanan AI/DS (FastAPI). Kosongkan jika belum ada -> chatbot pakai aturan sederhana.
AI_SERVICE_URL=
AI_INTERNAL_KEY=
